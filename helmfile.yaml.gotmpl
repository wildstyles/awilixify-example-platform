# Helmfile is the inventory of Kubernetes releases installed into EKS. Chart
# versions and values live here; GitHub Actions only supplies deployment-specific
# values such as the VPC ID, AWS account registry, and application image tag.

repositories:
  - name: external-secrets
    url: https://charts.external-secrets.io
  - name: eks
    url: https://aws.github.io/eks-charts
  - name: external-dns
    url: https://kubernetes-sigs.github.io/external-dns/
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts

helmDefaults:
  wait: true
  timeout: 600
  historyMax: 5

releases:
  - name: external-secrets
    namespace: external-secrets
    createNamespace: true
    chart: external-secrets/external-secrets
    version: 2.8.0
    timeout: 300
    needs:
      - kube-system/aws-load-balancer-controller
    labels:
      tier: controller
    values:
      - serviceAccount:
          name: external-secrets

  - name: aws-load-balancer-controller
    namespace: kube-system
    chart: eks/aws-load-balancer-controller
    version: 3.5.0
    timeout: 600
    labels:
      tier: controller
    values:
      - clusterName: {{ requiredEnv "CLUSTER_NAME" | quote }}
        region: {{ requiredEnv "AWS_REGION" | quote }}
        vpcId: {{ requiredEnv "VPC_ID" | quote }}
        replicaCount: 1
        # Reuse the webhook certificate across Helm upgrades. Otherwise the
        # chart rotates its CA while the existing controller Pod can continue
        # serving the previous certificate, temporarily blocking Kubernetes
        # API operations that invoke the admission webhook.
        keepTLSSecret: true
        serviceAccount:
          name: aws-load-balancer-controller

  - name: external-dns
    namespace: external-dns
    createNamespace: true
    chart: external-dns/external-dns
    version: 1.21.1
    timeout: 300
    needs:
      - kube-system/aws-load-balancer-controller
    labels:
      tier: controller
    values:
      - provider:
          name: aws
        serviceAccount:
          name: external-dns
        policy: sync
        txtOwnerId: {{ requiredEnv "CLUSTER_NAME" | quote }}
        domainFilters:
          - {{ requiredEnv "DOMAIN_NAME" | quote }}
        sources:
          - ingress
        env:
          - name: AWS_DEFAULT_REGION
            value: {{ requiredEnv "AWS_REGION" | quote }}
        extraArgs:
          aws-zone-type: public
        triggerLoopOnEvent: true

  - name: tempo
    namespace: monitoring
    createNamespace: true
    chart: grafana/tempo
    version: 1.24.4
    timeout: 600
    needs:
      - kube-system/aws-load-balancer-controller
    labels:
      tier: observability
    values:
      - monitoring/tempo-values.yaml

  - name: opentelemetry-collector
    namespace: monitoring
    createNamespace: true
    chart: open-telemetry/opentelemetry-collector
    version: 0.170.0
    timeout: 600
    needs:
      - monitoring/tempo
    labels:
      tier: observability
    values:
      - monitoring/opentelemetry-collector-values.yaml

  - name: awilixify-example-platform
    namespace: awilixify-example-platform
    createNamespace: true
    chart: ./helm
    timeout: 600
    needs:
      - external-secrets/external-secrets
      - kube-system/aws-load-balancer-controller
      - external-dns/external-dns
      - monitoring/opentelemetry-collector
    labels:
      tier: application
    values:
      - global:
          image:
            tag: {{ requiredEnv "IMAGE_TAG" | quote }}
        ordersApi:
          image:
            repository: {{ printf "%s/%s/orders-api" (requiredEnv "ECR_REGISTRY") (requiredEnv "ECR_NAMESPACE") | quote }}
        warehouseApi:
          image:
            repository: {{ printf "%s/%s/warehouse-api" (requiredEnv "ECR_REGISTRY") (requiredEnv "ECR_NAMESPACE") | quote }}

  - name: monitoring
    namespace: monitoring
    createNamespace: true
    chart: prometheus-community/kube-prometheus-stack
    version: 88.5.0
    timeout: 900
    needs:
      # The chart's extra manifests use CRDs installed by this controller.
      - external-secrets/external-secrets
      - monitoring/tempo
    labels:
      tier: observability
    values:
      - monitoring/kube-prometheus-stack-values.yaml
