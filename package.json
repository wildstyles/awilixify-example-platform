{
	"name": "awilixify-example-platform",
	"private": true,
	"packageManager": "pnpm@10.34.4",
	"scripts": {
		"dev": "pnpm ui:up && turbo run dev",
		"dev:api": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"typecheck": "turbo run typecheck",
		"ui:down": "docker compose down",
		"ui:logs": "docker compose logs --follow devtools-ui",
		"ui:up": "docker compose up --detach devtools-ui"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.15",
		"turbo": "^2.5.0",
		"typescript": "^5.9.3"
	}
}
