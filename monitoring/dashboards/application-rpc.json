{
	"apiVersion": "dashboard.grafana.app/v2",
	"kind": "Dashboard",
	"metadata": {
		"name": "ad4x5ck"
	},
	"spec": {
		"annotations": [
			{
				"kind": "AnnotationQuery",
				"spec": {
					"query": {
						"kind": "DataQuery",
						"group": "grafana",
						"version": "v0",
						"datasource": {
							"name": "-- Grafana --"
						},
						"spec": {}
					},
					"enable": true,
					"hide": true,
					"iconColor": "rgba(0, 211, 255, 1)",
					"name": "Annotations & Alerts",
					"builtIn": true
				}
			}
		],
		"cursorSync": "Off",
		"editable": true,
		"elements": {
			"panel-1": {
				"kind": "Panel",
				"spec": {
					"id": 1,
					"title": "Requests per second by endpoint",
					"description": "HTTP server request rate generated from OpenTelemetry spans.",
					"links": [],
					"data": {
						"kind": "QueryGroup",
						"spec": {
							"queries": [
								{
									"kind": "PanelQuery",
									"spec": {
										"query": {
											"kind": "DataQuery",
											"group": "prometheus",
											"version": "v0",
											"datasource": {
												"name": "prometheus"
											},
											"spec": {
												"editorMode": "code",
												"expr": "sum by (\n  service,\n  http_request_method,\n  http_route\n) (\n  rate(\n    traces_spanmetrics_calls_total{\n      span_kind=\"SPAN_KIND_SERVER\",\n      http_route!=\"\"\n    }[1m]\n  )\n)",
												"instant": false,
												"key": "rpc-request-rate",
												"legendFormat": "{{service}} {{http_request_method}} {{http_route}}",
												"range": true
											}
										},
										"refId": "A",
										"hidden": false
									}
								}
							],
							"transformations": [],
							"queryOptions": {}
						}
					},
					"vizConfig": {
						"kind": "VizConfig",
						"group": "timeseries",
						"version": "13.2.0",
						"spec": {
							"options": {
								"legend": {
									"calcs": ["lastNotNull", "max"],
									"displayMode": "table",
									"placement": "bottom",
									"showLegend": true
								},
								"tooltip": {
									"hideZeros": false,
									"mode": "multi",
									"sort": "desc"
								}
							},
							"fieldConfig": {
								"defaults": {
									"unit": "reqps",
									"min": 0,
									"thresholds": {
										"mode": "absolute",
										"steps": [
											{
												"value": 0,
												"color": "green"
											}
										]
									},
									"color": {
										"mode": "palette-classic"
									},
									"custom": {
										"axisBorderShow": false,
										"axisCenteredZero": false,
										"axisColorMode": "text",
										"axisLabel": "Requests/second",
										"axisPlacement": "left",
										"barAlignment": 0,
										"barWidthFactor": 0.6,
										"drawStyle": "line",
										"fillOpacity": 10,
										"gradientMode": "none",
										"hideFrom": {
											"legend": false,
											"tooltip": false,
											"viz": false
										},
										"insertNulls": false,
										"lineInterpolation": "linear",
										"lineWidth": 2,
										"pointSize": 4,
										"scaleDistribution": {
											"type": "linear"
										},
										"showPoints": "never",
										"showValues": false,
										"spanNulls": false,
										"stacking": {
											"group": "A",
											"mode": "none"
										},
										"thresholdsStyle": {
											"mode": "off"
										}
									}
								},
								"overrides": []
							}
						}
					}
				}
			},
			"panel-2": {
				"kind": "Panel",
				"spec": {
					"id": 2,
					"title": "p95 response time by endpoint",
					"description": "95th percentile server response time generated from OpenTelemetry spans.",
					"links": [],
					"data": {
						"kind": "QueryGroup",
						"spec": {
							"queries": [
								{
									"kind": "PanelQuery",
									"spec": {
										"query": {
											"kind": "DataQuery",
											"group": "prometheus",
											"version": "v0",
											"datasource": {
												"name": "prometheus"
											},
											"spec": {
												"editorMode": "code",
												"expr": "histogram_quantile(\n  0.95,\n  sum by (\n    le,\n    service,\n    http_request_method,\n    http_route\n  ) (\n    rate(\n      traces_spanmetrics_latency_bucket{\n        span_kind=\"SPAN_KIND_SERVER\",\n        http_route!=\"\"\n      }[2m]\n    )\n  )\n)",
												"instant": false,
												"key": "rpc-p95-latency",
												"legendFormat": "{{service}} {{http_request_method}} {{http_route}}",
												"range": true
											}
										},
										"refId": "A",
										"hidden": false
									}
								}
							],
							"transformations": [],
							"queryOptions": {}
						}
					},
					"vizConfig": {
						"kind": "VizConfig",
						"group": "timeseries",
						"version": "13.2.0",
						"spec": {
							"options": {
								"legend": {
									"calcs": ["lastNotNull", "max"],
									"displayMode": "table",
									"placement": "bottom",
									"showLegend": true
								},
								"tooltip": {
									"hideZeros": false,
									"mode": "multi",
									"sort": "desc"
								}
							},
							"fieldConfig": {
								"defaults": {
									"unit": "s",
									"min": 0,
									"thresholds": {
										"mode": "absolute",
										"steps": [
											{
												"value": 0,
												"color": "green"
											}
										]
									},
									"color": {
										"mode": "palette-classic"
									},
									"custom": {
										"axisBorderShow": false,
										"axisCenteredZero": false,
										"axisColorMode": "text",
										"axisLabel": "p95 response time",
										"axisPlacement": "left",
										"barAlignment": 0,
										"barWidthFactor": 0.6,
										"drawStyle": "line",
										"fillOpacity": 10,
										"gradientMode": "none",
										"hideFrom": {
											"legend": false,
											"tooltip": false,
											"viz": false
										},
										"insertNulls": false,
										"lineInterpolation": "linear",
										"lineWidth": 2,
										"pointSize": 4,
										"scaleDistribution": {
											"type": "linear"
										},
										"showPoints": "never",
										"showValues": false,
										"spanNulls": false,
										"stacking": {
											"group": "A",
											"mode": "none"
										},
										"thresholdsStyle": {
											"mode": "off"
										}
									}
								},
								"overrides": []
							}
						}
					}
				}
			}
		},
		"layout": {
			"kind": "GridLayout",
			"spec": {
				"items": [
					{
						"kind": "GridLayoutItem",
						"spec": {
							"x": 0,
							"y": 0,
							"width": 24,
							"height": 9,
							"element": {
								"kind": "ElementReference",
								"name": "panel-1"
							}
						}
					},
					{
						"kind": "GridLayoutItem",
						"spec": {
							"x": 0,
							"y": 9,
							"width": 24,
							"height": 9,
							"element": {
								"kind": "ElementReference",
								"name": "panel-2"
							}
						}
					}
				]
			}
		},
		"links": [],
		"liveNow": false,
		"preload": false,
		"tags": ["application", "opentelemetry", "rpc"],
		"timeSettings": {
			"timezone": "browser",
			"from": "now-15m",
			"to": "now",
			"autoRefresh": "5s",
			"autoRefreshIntervals": [
				"5s",
				"10s",
				"30s",
				"1m",
				"5m",
				"15m",
				"30m",
				"1h"
			],
			"hideTimepicker": false,
			"fiscalYearStartMonth": 0
		},
		"title": "Application RPC",
		"variables": [],
		"preferences": {
			"layout": {
				"kind": "GridLayout",
				"spec": {
					"items": []
				}
			}
		}
	}
}
