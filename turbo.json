{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"dependsOn": ["^build"],
			"persistent": true
		},
		"generate": {
			"cache": false
		},
		"lint": {},
		"lint:fix": {
			"cache": false
		},
		"typecheck": {}
	}
}
